{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/secreto/",
      "destination": "/secreto/index.html"
    },
    {
      "source": "/antes-de-morir/",
      "destination": "/antes-de-morir/index.html"
    },
    {
      "source": "/quanta/",
      "destination": "/quanta/index.html"
    },
    {
      "source": "/privacidad/",
      "destination": "/privacidad/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/secreto",
      "destination": "/secreto/",
      "permanent": true
    },
    {
      "source": "/antes-de-morir",
      "destination": "/antes-de-morir/",
      "permanent": true
    },
    {
      "source": "/quanta",
      "destination": "/quanta/",
      "permanent": true
    },
    {
      "source": "/privacidad",
      "destination": "/privacidad/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "boom-landing-ten.vercel.app"
        }
      ],
      "destination": "https://www.voomverse.com/:path*",
      "permanent": true
    }
  ]
}
